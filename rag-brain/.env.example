# ============================================================
# rag-brain environment configuration
# Copy to .env for local dev. In production, provide these from
# environment variables or a secrets manager.
# ============================================================

# --- Database (matches docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:6435/pds_rag_brain
DB_USERNAME=pds_rag_brain
DB_PASSWORD=pds_local_dev_only

# --- AI providers ---
# AI keys may be blank for dashboard/admin boot.
# OPENAI_API_KEY is required for text-embedding-3-small ingestion/retrieval.
# At least one answer provider or LOCAL_LLM_BASE_URL is required for generated answers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- AI HTTP timeouts (outbound provider/embedding calls) ---
# Guard against hung providers. read timeout must exceed normal completion latency.
AI_CONNECT_TIMEOUT_MS=10000
AI_READ_TIMEOUT_MS=60000
# Max source-context tokens packed into a prompt (cl100k_base). Prevents context-window overflow.
AI_MAX_CONTEXT_TOKENS=12000

# --- Model routing ---
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_AI_MODEL=claude-haiku-4-5
FALLBACK_AI_PROVIDER=openai
FALLBACK_AI_MODEL=gpt-4.1-nano

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=8
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
RETRIEVAL_RERANK_ENABLED=true

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6173,http://localhost:6174

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=10
CONNECTOR_RATE_LIMIT_REQUESTS_PER_MINUTE=60
ADMIN_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# X-Forwarded-For is spoofable, so it is ignored unless the app is strictly
# behind a trusted proxy. Enable only when ALL traffic flows through your proxy,
# and set the count to the number of proxies appending to the header.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
RATE_LIMIT_TRUSTED_PROXY_COUNT=1

# --- Admin API protection ---
ADMIN_API_KEY=change-me-local-admin-key

# --- Direct tool adapter secrets ---
# Direct tool adapters store only secretRef in PostgreSQL.
# Provide actual secrets as RAG_TOOL_SECRET_<SECRET_REF>.
# Example for secretRef=dashboard_api:
# RAG_TOOL_SECRET_DASHBOARD_API=

# Public website assistant tokens are generated per brain from the dashboard/API.
# They are stored hashed in PostgreSQL and are separate from ADMIN_API_KEY.
# Do not add a static public token env var here as an app setting.

# --- Default brain and local corpus ---
# Keep the platform default generic and empty.
DOCUMENT_STORAGE_PATH=./data/generic-documents
BRAIN_PACK=packs/generic
BRAIN_SLUG=generic
BRAIN_NAME="Generic Brain"

# --- Dashboard ---
# The Test Console's full ask mode calls /api/ai/<slug>/ask?brain=<active-brain>.
# Keep this generic for new deployments; set to an existing route slug only for legacy sites.
VITE_LEGACY_ASK_SLUG=generic

# --- Optional S3 corpus source for the default brain ---
S3_BUCKET=
S3_PREFIX=
AWS_REGION=us-west-1

# --- Optional extra AI providers (blank = hidden/unconfigured) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
GROK_API_KEY=
# GROK_MODEL=grok-4.3

# --- Local/self-hosted OpenAI-compatible LLM ---
# Example: http://127.0.0.1:11434/v1 for Ollama's OpenAI-compatible server.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# Comma-separated host allowlist for per-brain local endpoints.
# Empty uses LocalEndpointValidator defaults.
LOCAL_LLM_ALLOWED_HOSTS=

# --- Instance control plane (all default OFF; activation order matters) ---
# Rollout gates, in order (docs/runbooks/instance-control-plane-rollout.md):
#   1. RAGBRAIN_INSTANCES_ENABLED           generalized admin reads and authoring
#   2. VITE_INSTANCE_CONTROL_ENABLED        dashboard build flag (build-time, not runtime)
#   3. RAGBRAIN_INSTANCES_EXECUTION_ENABLED dispatcher; requires 1, a payload key, engine
#                                           config, a model catalog, and an explicit
#                                           positive retention policy
#   4. RAGBRAIN_INSTANCES_CONNECTOR_ENABLED Document Manager surface; requires 1 + engine
#                                           config + model catalog
#   5. RAGBRAIN_INSTANCES_PROMOTION_ENABLED live-pointer moves; requires 1
# An incoherent combination refuses at startup, naming the property keys.
RAGBRAIN_INSTANCES_ENABLED=false
RAGBRAIN_INSTANCES_EXECUTION_ENABLED=false
RAGBRAIN_INSTANCES_CONNECTOR_ENABLED=false

# ------------------------------------------------------------
# assets.ledger.v1 — the Document Engine's own bank-statement field names.
#
# With these set, an instance release that pins the assets.ledger.v1 tool builds the
# transaction ledger from parsed facts and the model never transcribes a statement.
# Left empty the tool registers but refuses to run and warns at boot; it does NOT fall
# back to an empty ledger, because an empty ledger reconciles trivially and would read as
# a clean review of no statements at all.
#
# These are ENGINE field names, not guideline policy — they change when the engine's
# extraction schema changes. Analyzer rules stay in packs/*/analyzers.yaml.
#
# Rows are found by the engine's own groupKey: null-key fields are the account header and
# each distinct non-null key is one transaction.
#
# Set TXN_DIRECTION only if the engine reports magnitude plus a separate credit/debit
# indicator; leave it empty when amounts already carry their sign. Getting it wrong makes
# the reconciliation check fail loudly rather than corrupting totals silently.
# ------------------------------------------------------------
RAGBRAIN_ASSETS_LEDGER_DOCUMENT_TYPES=
RAGBRAIN_ASSETS_LEDGER_INSTITUTION=
RAGBRAIN_ASSETS_LEDGER_MASKED_NUMBER=
RAGBRAIN_ASSETS_LEDGER_ACCOUNT_TYPE=
RAGBRAIN_ASSETS_LEDGER_STATEMENT_START=
RAGBRAIN_ASSETS_LEDGER_STATEMENT_END=
RAGBRAIN_ASSETS_LEDGER_BEGINNING_BALANCE=
RAGBRAIN_ASSETS_LEDGER_ENDING_BALANCE=
RAGBRAIN_ASSETS_LEDGER_TXN_DATE=
RAGBRAIN_ASSETS_LEDGER_TXN_DESCRIPTION=
RAGBRAIN_ASSETS_LEDGER_TXN_AMOUNT=
RAGBRAIN_ASSETS_LEDGER_TXN_RUNNING_BALANCE=
RAGBRAIN_ASSETS_LEDGER_TXN_DIRECTION=
RAGBRAIN_ASSETS_LEDGER_TXN_CREDIT_VALUES=
RAGBRAIN_INSTANCES_PROMOTION_ENABLED=false
# Terminal run history retention in days. 0 = undecided, which refuses execution enablement:
# an indefinite default for encrypted run history is a policy nobody chose.
RAGBRAIN_INSTANCES_RETENTION_TERMINAL_RUN_DAYS=0

# --- Income Lab prototype + Document Engine (shared by the instance plane) ---
RAGBRAIN_LAB_ENABLED=false
# AES-256-GCM key for encrypted run payloads: exactly 32 bytes, Base64. Required before
# instance execution is enabled. Never exposed to a browser or a JavaScript bundle.
LAB_PAYLOAD_KEY=
LAB_ENGINE_BASE_URL=http://localhost:9090

# --- Dashboard build flags (build-time; rebuild to change) ---
VITE_INSTANCE_CONTROL_ENABLED=false
VITE_FOLDER_AI_LAB_ENABLED=false
