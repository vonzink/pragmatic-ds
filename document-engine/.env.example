# ============================================================
# Pragmatic DS Document Engine — local environment
# Copy to .env (gitignored via *.env). docker compose reads it for
# variable substitution; the API reads the same names when run
# from the host with ./gradlew :app:bootRun.
# Every secret below is LOCAL ONLY — generate new ones per environment.
# ============================================================

# --- Database (docker-compose.yml: Postgres on localhost:6433) ---
DOCENGINE_DB_PASSWORD=
# Host-run API (bootRun) connects directly; compose sets its own URL.
DOCENGINE_DB_URL=jdbc:postgresql://localhost:6433/docengine
DOCENGINE_DB_USER=docengine

# --- Worker (FastAPI on localhost:9091) ---
DOCENGINE_WORKER_URL=http://localhost:9091
DOCENGINE_WORKER_SECRET=

# --- Engine secrets ---
DOCENGINE_AUDIT_IP_HASH_SECRET=
DOCENGINE_SIGNED_URL_SECRET=
DOCENGINE_APIKEY_SALT=

# --- Storage ---
DOCENGINE_STORAGE_DRIVER=local
DOCENGINE_STORAGE_ROOT=./data/blobs

# --- AI extraction (off until a Pragmatic DS key is added) ---
DOCENGINE_AI_ENABLED=false
DOCENGINE_AI_PROVIDER=anthropic
DOCENGINE_AI_API_KEY=
